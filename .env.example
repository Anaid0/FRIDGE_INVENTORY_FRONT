# URL de la API. En desarrollo se deja en /api y Vite la redirige al backend (ver vite.config.ts).
VITE_API_URL=/api
# App Android (APK): dirección de la API con la que viene de fábrica; si está, la app no pide el servidor
# al abrirla. Vacío: la pide la primera vez (IP de la red de la oficina, ej. 192.168.1.50:3000).
VITE_NATIVE_API_URL=
# Formato de dinero
VITE_CURRENCY=COP
VITE_LOCALE=es-CO
